{
  "name": "nabiz-haber",
  "version": "0.1.0",
  "private": true,
  "description": "Nabız Haber — Türkiye odaklı haber okuyucu (RSS + sosyal + canlı piyasa)",
  "author": "Nabız",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "fetch": "node fetch-news.js",
    "serve": "node server.js",
    "start": "node fetch-news.js && node server.js",
    "app": "electron .",
    "dist": "electron-builder --win"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.nabiz.haber",
    "productName": "Nabiz Haber",
    "asar": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**",
      "server.js",
      "fetch-news.js",
      "lib/**",
      "config/**",
      "public/**",
      "data/social/README.md",
      "package.json"
    ],
    "win": {
      "target": [
        "portable"
      ]
    },
    "portable": {
      "artifactName": "NabizHaber.exe"
    }
  }
}
